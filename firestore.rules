rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connectivity test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Institutions collection
    match /institutions/{institutionId} {
      allow read, write: if isValidId(institutionId);
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Classes collection
    match /classes/{classId} {
      allow read, write: if isValidId(classId);
    }

    // Students collection
    match /students/{studentId} {
      allow read, write: if isValidId(studentId);
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read, write: if isValidId(subjectId);
    }

    // Timetables and schedules
    match /timetables/{timetableId} {
      allow read, write: if isValidId(timetableId);
    }

    match /schedule/{scheduleId} {
      allow read, write: if isValidId(scheduleId);
    }

    // Rooms
    match /rooms/{roomId} {
      allow read, write: if isValidId(roomId);
    }

    // Time slots
    match /time_slots/{slotId} {
      allow read, write: if isValidId(slotId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }

    // Staff Attendance
    match /staff_attendance/{attendanceId} {
      allow read, write: if isValidId(attendanceId);
    }

    // Student Attendance
    match /attendance/{attendanceId} {
      allow read, write: if isValidId(attendanceId);
    }

    // Formal requests
    match /formal_requests/{requestId} {
      allow read, write: if isValidId(requestId);
    }

    // Citaciones & Exit passes
    match /citaciones/{citacionId} {
      allow read, write: if isValidId(citacionId);
    }
    match /exit_passes/{passId} {
      allow read, write: if isValidId(passId);
    }

    // Institutional documents & Meetings
    match /institutional_documents/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /meeting_records/{meetingId} {
      allow read, write: if isValidId(meetingId);
    }

    // Academic calendar, microplans, gradebooks, rubrics
    match /academic_calendar/{eventId} {
      allow read, write: if isValidId(eventId);
    }
    match /leccionario/{entryId} {
      allow read, write: if isValidId(entryId);
    }
    match /micro_plans/{planId} {
      allow read, write: if isValidId(planId);
    }
    match /gradebooks/{gradebookId} {
      allow read, write: if isValidId(gradebookId);
    }
    match /rubrics/{rubricId} {
      allow read, write: if isValidId(rubricId);
    }
    match /training_plans/{planId} {
      allow read, write: if isValidId(planId);
    }
    match /conflict_mediations/{mediationId} {
      allow read, write: if isValidId(mediationId);
    }
    match /cronograma_events/{eventId} {
      allow read, write: if isValidId(eventId);
    }
    match /health_records/{recordId} {
      allow read, write: if isValidId(recordId);
    }
    match /medical_visits/{visitId} {
      allow read, write: if isValidId(visitId);
    }

    // Fallback for any other educational collection
    match /{collection}/{document=**} {
      allow read, write: if true;
    }
  }
}
