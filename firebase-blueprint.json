{
  "entities": {
    "Institution": {
      "title": "Institution",
      "description": "Educational institution profile and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 50 },
        "codeAMIE": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "logoUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account information and system role",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "institutionId": { "type": "string", "maxLength": 128 },
        "cedula": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "email", "name", "role"]
    },
    "Class": {
      "title": "Class",
      "description": "Class or grade level group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "institutionId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name"]
    },
    "Student": {
      "title": "Student",
      "description": "Student profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "institutionId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "institutionId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "maxLength": 50 },
        "read": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "message"]
    },
    "StaffAttendanceRecord": {
      "title": "StaffAttendanceRecord",
      "description": "Attendance clock-in and clock-out record for faculty and staff",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "institutionId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 30 },
        "punches": { "type": "array" }
      },
      "required": ["id", "userId", "date"]
    },
    "FormalRequest": {
      "title": "FormalRequest",
      "description": "Administrative formal request or leave permit",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "institutionId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "details": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "type", "status"]
    },
    "GenericDocument": {
      "title": "GenericDocument",
      "description": "Institutional records and academic plans",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    },
    "TestDoc": {
      "title": "TestDoc",
      "description": "Test connectivity document",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["status"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "description": "Student health card and medical history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "institutionId": { "type": "string", "maxLength": 128 },
        "allergies": { "type": "array" },
        "conditions": { "type": "array" },
        "medications": { "type": "array" },
        "lastCheckup": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId"]
    },
    "MedicalVisit": {
      "title": "MedicalVisit",
      "description": "Medical nurse/clinic visit log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "institutionId": { "type": "string", "maxLength": 128 },
        "healthProfessionalId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "date"]
    },
    "Intervention": {
      "title": "Intervention",
      "description": "DECE counseling session and psychological intervention record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "institutionId": { "type": "string", "maxLength": 128 },
        "deceProfessionalId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 3000 },
        "agreements": { "type": "string", "maxLength": 3000 }
      },
      "required": ["id", "studentId", "date", "type", "summary"]
    }
  },
  "firestore": {
    "/institutions/{institutionId}": {
      "schema": "Institution",
      "description": "Institution profiles"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "School classes"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student records"
    },
    "/health_records/{recordId}": {
      "schema": "HealthRecord",
      "description": "Student medical cards"
    },
    "/medical_visits/{visitId}": {
      "schema": "MedicalVisit",
      "description": "Clinical visits and consultations"
    },
    "/interventions/{interventionId}": {
      "schema": "Intervention",
      "description": "DECE psychological interventions and student files"
    },
    "/subjects/{subjectId}": {
      "schema": "GenericDocument",
      "description": "Academic subjects"
    },
    "/timetables/{timetableId}": {
      "schema": "GenericDocument",
      "description": "School schedules and timetables"
    },
    "/rooms/{roomId}": {
      "schema": "GenericDocument",
      "description": "Classrooms and physical spaces"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User alerts and notifications"
    },
    "/staff_attendance/{attendanceId}": {
      "schema": "StaffAttendanceRecord",
      "description": "Staff clock in punches"
    },
    "/formal_requests/{requestId}": {
      "schema": "FormalRequest",
      "description": "Staff administrative requests"
    },
    "/institutional_documents/{docId}": {
      "schema": "GenericDocument",
      "description": "Institutional governance documents"
    },
    "/meeting_records/{meetingId}": {
      "schema": "GenericDocument",
      "description": "Meeting minutes and records"
    },
    "/test/{docId}": {
      "schema": "TestDoc",
      "description": "Test connectivity collection"
    }
  }
}
